#!/bin/bash
#PBS -N cf-einfra-smoke
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

PROJECT_DIR="${PROJECT_DIR:-${PBS_O_WORKDIR:-$PWD}}"
cd "$PROJECT_DIR"

PYTHON="${PYTHON:-./.venv/bin/python}"
BASE_URL="${BASE_URL:-https://llm.ai.e-infra.cz/v1}"
OUTPUT_ROOT="${OUTPUT_ROOT:-data/einfra_smoke}"
JUDGE_OUTPUT_DIR="${JUDGE_OUTPUT_DIR:-$OUTPUT_ROOT/judged}"
JUDGE_MODEL="${JUDGE_MODEL:-glm-5.2}"
JUDGE_KEYS="${JUDGE_KEYS:-EINFRA_VS,EINFRA_KD}"
CONCURRENCY_PER_KEY="${CONCURRENCY_PER_KEY:-4}"
FALLBACK_CONCURRENCY_PER_KEY="${FALLBACK_CONCURRENCY_PER_KEY:-3}"
LONG_RETRY_SLEEP="${LONG_RETRY_SLEEP:-50}"
REQUEST_JITTER_MIN="${REQUEST_JITTER_MIN:-0.1}"
REQUEST_JITTER_MAX="${REQUEST_JITTER_MAX:-0.5}"
LIMIT="${LIMIT:-2}"
CLASSIFICATION_REPEATS="${CLASSIFICATION_REPEATS:-5}"
CLASSIFICATION_TEMPERATURE="${CLASSIFICATION_TEMPERATURE:-1.0}"

mkdir -p logs "$OUTPUT_ROOT" "$JUDGE_OUTPUT_DIR"
LOG_FILE="logs/metacentrum_smoke_${PBS_JOBID:-manual}.log"
exec > >(tee -a "$LOG_FILE") 2>&1
START_EPOCH="$(date +%s)"
echo "[start] $(date -Is) job=${PBS_JOBID:-manual} project=$PROJECT_DIR output_root=$OUTPUT_ROOT log=$LOG_FILE"
finish() {
  local status=$?
  local end_epoch
  local elapsed_seconds
  end_epoch="$(date +%s)"
  elapsed_seconds=$((end_epoch - START_EPOCH))
  echo "[end] $(date -Is) status=$status elapsed_seconds=$elapsed_seconds"
}
trap finish EXIT
export BASE_URL

require_python() {
  if [ ! -x "$PYTHON" ]; then
    echo "Missing Python executable: $PYTHON" >&2
    echo "Create the venv first, for example: python3 -m venv .venv && ./.venv/bin/pip install pandas==2.3.3 requests==2.32.5" >&2
    exit 1
  fi
}

check_keys() {
  local keys="$1"
  "$PYTHON" - "$keys" <<'PY'
import os
import sys
from pathlib import Path

env_path = Path(".env.local")
if env_path.exists():
    for raw_line in env_path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        os.environ.setdefault(key.strip(), value.strip().strip('"').strip("'"))

keys = [key for key in sys.argv[1].split(",") if key]
missing = [key for key in keys if not os.getenv(key)]
if missing:
    raise SystemExit("Missing token environment variable(s): " + ", ".join(missing))
PY
}

run_generate() {
  local model="$1"
  local keys="$2"
  local task="$3"
  local dataset="$4"
  local variant="$5"
  local language="$6"
  local output_model="${7:-$model}"
  local kind_args=()
  local repeat_args=()
  local temperature_args=(--temperature 0)

  if [ "$dataset" = "cs-qa" ] || [ "$dataset" = "sk-qa" ]; then
    kind_args=(--kind original)
  fi
  if [ "$task" = "classified" ]; then
    repeat_args=(--repeats "$CLASSIFICATION_REPEATS")
    temperature_args=(--temperature "$CLASSIFICATION_TEMPERATURE")
  fi

  echo "[generate] model=$model task=$task dataset=$dataset variant=$variant language=$language limit=$LIMIT repeats=${repeat_args[*]:-1} temperature=${temperature_args[1]}"
  if "$PYTHON" generate_speeches.py \
      --model "$model" \
      --output-model-name "$output_model" \
      --dataset "$dataset" \
      --variant "$variant" \
      --language "$language" \
      --task "$task" \
      --token-env-vars "$keys" \
      --concurrency-per-key "$CONCURRENCY_PER_KEY" \
      --retry-attempts 4 \
      --long-retry-sleep "$LONG_RETRY_SLEEP" \
      --request-jitter-min "$REQUEST_JITTER_MIN" \
      --request-jitter-max "$REQUEST_JITTER_MAX" \
      --limit "$LIMIT" \
      --output-root "$OUTPUT_ROOT" \
      "${temperature_args[@]}" \
      "${repeat_args[@]}" \
      "${kind_args[@]}"; then
    return 0
  fi

  echo "[fallback generate] model=$model task=$task dataset=$dataset variant=$variant language=$language"
  "$PYTHON" generate_speeches.py \
    --model "$model" \
    --output-model-name "$output_model" \
    --dataset "$dataset" \
    --variant "$variant" \
    --language "$language" \
    --task "$task" \
    --token-env-vars "$keys" \
    --concurrency-per-key "$FALLBACK_CONCURRENCY_PER_KEY" \
    --retry-attempts 4 \
    --long-retry-sleep "$LONG_RETRY_SLEEP" \
    --request-jitter-min "$REQUEST_JITTER_MIN" \
    --request-jitter-max "$REQUEST_JITTER_MAX" \
    --limit "$LIMIT" \
    --output-root "$OUTPUT_ROOT" \
    "${temperature_args[@]}" \
    "${repeat_args[@]}" \
    "${kind_args[@]}"
}

run_judge() {
  local model="$1"
  local dataset="$2"
  local variant="$3"
  local language="$4"
  local output_model="${5:-$model}"
  local csv="$OUTPUT_ROOT/generated/$output_model/${dataset}_${variant}_${language}.csv"

  echo "[judge] csv=$csv judge_model=$JUDGE_MODEL"
  if "$PYTHON" llm-judge/judge_csv.py "$csv" \
      --sample-size all \
      --model "$JUDGE_MODEL" \
      --judge-base-url "$BASE_URL" \
      --token-env-vars "$JUDGE_KEYS" \
      --concurrency-per-key "$CONCURRENCY_PER_KEY" \
      --output-dir "$JUDGE_OUTPUT_DIR" \
      --retry-attempts 4 \
      --long-retry-sleep "$LONG_RETRY_SLEEP" \
      --request-jitter-min "$REQUEST_JITTER_MIN" \
      --request-jitter-max "$REQUEST_JITTER_MAX"; then
    return 0
  fi

  echo "[fallback judge] csv=$csv judge_model=$JUDGE_MODEL"
  "$PYTHON" llm-judge/judge_csv.py "$csv" \
    --sample-size all \
    --model "$JUDGE_MODEL" \
    --judge-base-url "$BASE_URL" \
    --token-env-vars "$JUDGE_KEYS" \
    --concurrency-per-key "$FALLBACK_CONCURRENCY_PER_KEY" \
    --output-dir "$JUDGE_OUTPUT_DIR" \
    --retry-attempts 4 \
    --long-retry-sleep "$LONG_RETRY_SLEEP" \
    --request-jitter-min "$REQUEST_JITTER_MIN" \
    --request-jitter-max "$REQUEST_JITTER_MAX"
}

run_model_smoke() {
  local model="$1"
  local keys="$2"
  local output_model="${3:-$model}"
  local judge_pid
  local judge_status

  check_keys "$keys"

  for variant in cf fa; do
    run_generate "$model" "$keys" generated cs-qa "$variant" en "$output_model"
    run_judge "$model" cs-qa "$variant" en "$output_model" &
    judge_pid=$!
    run_generate "$model" "$keys" classified cs-qa "$variant" en "$output_model"
    judge_status=0
    wait "$judge_pid" || judge_status=$?
    if [ "$judge_status" -ne 0 ]; then
      echo "[failed judge] model=$model variant=$variant language=en" >&2
      return "$judge_status"
    fi
  done
}

require_python
check_keys "$JUDGE_KEYS"

run_model_smoke "llama-4-scout-17b-16e-instruct" "EINFRA_AP"
run_model_smoke "gemma4" "EINFRA_VD" "gemma4-31B"
run_model_smoke "qwen3.5-122b" "EINFRA_TS"

echo "[done] smoke outputs under $OUTPUT_ROOT"
