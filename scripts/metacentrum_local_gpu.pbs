#!/bin/bash
# Local-GPU generation + classification for one model via a vLLM server.
#
# Variant A: serve the model locally with vLLM (OpenAI-compatible endpoint) and
# point the unchanged generate_speeches.py / api_caller.py at localhost. No API
# keys, no per-key concurrency cap; the server's continuous batcher stays busy as
# long as --max-workers is high.
#
# Submit one model:
#   qsub -v MODEL_ID=google/gemma-4-E4B-it,MODEL_NAME=gemma4-e4b scripts/metacentrum_local_gpu.pbs
#   qsub -v MODEL_ID=CohereLabs/tiny-aya-global,MODEL_NAME=tiny-aya-global,MAX_MODEL_LEN=8192 scripts/metacentrum_local_gpu.pbs
# Or submit both at once:  scripts/submit_local_gpu_all.sh
# Track:                   qstat -u $USER
#PBS -N cf-local-gpu
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:gpu_mem=24gb:mem=24gb:scratch_local=40gb
#PBS -l walltime=10:00:00
#PBS -j oe

set -euo pipefail

PROJECT_DIR="${PROJECT_DIR:-${PBS_O_WORKDIR:-$PWD}}"
cd "$PROJECT_DIR"

# Mirror everything the job prints into logs/ as well as the PBS .o spool file,
# so a copy of the run survives next to vllm-<model>.log without hunting for the
# spool. File name matches the PBS .o convention (cf-local-gpu.o<jobid>).
mkdir -p logs
JOB_TAG="${PBS_JOBID%%.*}"
JOB_LOG="logs/cf-local-gpu.o${JOB_TAG:-local}"
exec > >(tee -a "$JOB_LOG") 2>&1

source scripts/gpu_env.sh

# ---- Model (override via -v) -------------------------------------------------
MODEL_ID="${MODEL_ID:-google/gemma-4-E4B-it}"   # HuggingFace id that vLLM loads
MODEL_NAME="${MODEL_NAME:-gemma4-e4b}"          # served name + output folder name
MAX_MODEL_LEN="${MAX_MODEL_LEN:-1536}"          # worst prompt ~600 tok + 512 out; tiny KV footprint
# Pick a free TCP port instead of hardcoding 8000: two GPU jobs can land on the
# same physical node, where 127.0.0.1 is host-wide, so a fixed port makes the
# second server crash with "Address already in use". Server and client both
# derive off $PORT below, so they stay in sync.
PORT="${PORT:-$("${PYTHON:-python}" -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.90}"

# ---- Work matrix (override via -v) ------------------------------------------
OUTPUT_ROOT="${OUTPUT_ROOT:-data/local_gpu}"
DATASETS="${DATASETS:-cs-qa sk-qa}"
VARIANTS="${VARIANTS:-cf fa}"
LANGUAGES="${LANGUAGES:-en cs sk}"
TASKS="${TASKS:-generated classified}"
MAX_WORKERS="${MAX_WORKERS:-64}"                # client concurrency -> server batch size
LIMIT="${LIMIT:-}"                              # empty = all entries
SKIP_EXISTING="${SKIP_EXISTING:-1}"            # 1 = resume (skip combos whose CSV exists); 0 = overwrite
CLASSIFICATION_REPEATS="${CLASSIFICATION_REPEATS:-5}"
CLASSIFICATION_TEMPERATURE="${CLASSIFICATION_TEMPERATURE:-1.0}"

PYTHON="${PYTHON:-python}"
mkdir -p logs "$OUTPUT_ROOT"

START_TS=$(date +%s)
echo "[start] $(date '+%Y-%m-%d %H:%M:%S') host=$(hostname) model=$MODEL_NAME ($MODEL_ID)"

# ---- Launch the vLLM server -------------------------------------------------
SERVER_LOG="logs/vllm-${MODEL_NAME}.log"
echo "[serve] $MODEL_ID as '$MODEL_NAME' on 127.0.0.1:$PORT (log: $SERVER_LOG)"
"$PYTHON" -m vllm.entrypoints.openai.api_server \
  --model "$MODEL_ID" \
  --served-model-name "$MODEL_NAME" \
  --host 127.0.0.1 \
  --port "$PORT" \
  --max-model-len "$MAX_MODEL_LEN" \
  --gpu-memory-utilization "$GPU_MEM_UTIL" \
  > "$SERVER_LOG" 2>&1 &
SERVER_PID=$!

# Always stop the server when the job ends (success, failure, or walltime kill).
# Escalate SIGTERM -> SIGKILL with a grace window and reap children; never block
# on `wait`, because vLLM can ignore SIGTERM mid-CUDA-init and hang the job.
cleanup() {
  echo "[cleanup] stopping vLLM server (pid $SERVER_PID)"
  kill "$SERVER_PID" 2>/dev/null || true
  for _ in $(seq 1 15); do
    kill -0 "$SERVER_PID" 2>/dev/null || break
    sleep 1
  done
  kill -9 "$SERVER_PID" 2>/dev/null || true
  pkill -9 -P "$SERVER_PID" 2>/dev/null || true
}
trap cleanup EXIT

# ---- Wait until the server is ready -----------------------------------------
# First run also downloads several GB of weights + runs torch.compile, so the
# window is generous. Subsequent runs hit the cache and become ready in minutes.
WAIT_SECS="${WAIT_SECS:-3600}"
echo "[wait] polling http://127.0.0.1:$PORT/health (up to ${WAIT_SECS}s)"
ready=0
for _ in $(seq 1 "$WAIT_SECS"); do
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "[error] vLLM server exited during startup; see $SERVER_LOG" >&2
    tail -n 40 "$SERVER_LOG" >&2 || true
    exit 1
  fi
  if curl -sf "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
    ready=1
    echo "[ready] server is up"
    break
  fi
  sleep 1
done
[ "$ready" = 1 ] || {
  echo "[error] server not ready after ${WAIT_SECS}s; see $SERVER_LOG" >&2
  exit 1
}

# ---- Point the client at the local server -----------------------------------
export BASE_URL="http://127.0.0.1:$PORT/v1"
unset AUTH_TOKEN 2>/dev/null || true   # no auth needed for the local server

# ---- Run generation + classification ----------------------------------------
run_one() {
  local task="$1" dataset="$2" variant="$3" language="$4"
  local extra=()

  # cs-qa / sk-qa filter on kind=original (matches the e-infra pipeline).
  if [ "$dataset" = "cs-qa" ] || [ "$dataset" = "sk-qa" ]; then
    extra+=(--kind original)
  fi
  if [ "$task" = "classified" ]; then
    extra+=(--repeats "$CLASSIFICATION_REPEATS" --temperature "$CLASSIFICATION_TEMPERATURE")
  else
    extra+=(--temperature 0)
  fi
  if [ -n "$LIMIT" ]; then
    extra+=(--limit "$LIMIT")
  fi
  if [ "$SKIP_EXISTING" = 1 ]; then
    extra+=(--skip-existing)
  fi

  echo "[run] task=$task model=$MODEL_NAME dataset=$dataset variant=$variant language=$language"
  "$PYTHON" generate_speeches.py \
    --model "$MODEL_NAME" \
    --dataset "$dataset" \
    --variant "$variant" \
    --language "$language" \
    --task "$task" \
    --max-workers "$MAX_WORKERS" \
    --output-root "$OUTPUT_ROOT" \
    "${extra[@]}"
}

for task in $TASKS; do
  for dataset in $DATASETS; do
    for variant in $VARIANTS; do
      for language in $LANGUAGES; do
        run_one "$task" "$dataset" "$variant" "$language"
      done
    done
  done
done

END_TS=$(date +%s); ELAPSED=$((END_TS - START_TS))
printf '[done] end=%s start=%s elapsed=%02d:%02d:%02d outputs under %s/{generated,classified}/%s\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')" \
  "$(date -d "@$START_TS" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$START_TS")" \
  $((ELAPSED/3600)) $(((ELAPSED%3600)/60)) $((ELAPSED%60)) \
  "$OUTPUT_ROOT" "$MODEL_NAME"
