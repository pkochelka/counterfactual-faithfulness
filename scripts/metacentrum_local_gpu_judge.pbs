#!/bin/bash
# LLM-as-judge over the local-GPU generated speeches (gemma4-e4b, tiny-aya-global).
#
# The judge scores each GENERATED sentence for faithfulness (1-5) against the
# source triples in data/{dataset}/{variant}.csv. It does NOT touch the classified
# outputs. Scoring runs entirely over the e-infra OpenAI-compatible API (default
# model glm-5.2), so this is a CPU-only job -- no GPU, no vLLM. Keys are read from
# .env.local by judge_csv.py's load_env_defaults().
#
# Submit (from the project root):
#   qsub scripts/metacentrum_local_gpu_judge.pbs
# Overrides (-v KEY=VALUE,...):
#   qsub -v JUDGE_MODEL=glm-5.2 scripts/metacentrum_local_gpu_judge.pbs
#   qsub -v MODELS=gemma4-e4b,DATASETS=cs-qa,LANGUAGES=en scripts/metacentrum_local_gpu_judge.pbs
# Track:  qstat -u $USER
#PBS -N cf-local-gpu-judge
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

PROJECT_DIR="${PROJECT_DIR:-${PBS_O_WORKDIR:-$PWD}}"
cd "$PROJECT_DIR"

# Mirror the job output into logs/ next to the PBS .o spool, matching the
# convention used by the other local-GPU scripts.
mkdir -p logs
JOB_TAG="${PBS_JOBID%%.*}"
JOB_LOG="logs/cf-local-gpu-judge.o${JOB_TAG:-local}"
exec > >(tee -a "$JOB_LOG") 2>&1

# ---- Config (override via -v) -----------------------------------------------
PYTHON="${PYTHON:-./.venv/bin/python}"            # CPU venv (pandas + requests)
OUTPUT_ROOT="${OUTPUT_ROOT:-data/local_gpu}"      # where generated/ lives + judged/ goes
JUDGE_OUTPUT_DIR="${JUDGE_OUTPUT_DIR:-$OUTPUT_ROOT/judged}"
JUDGE_MODEL="${JUDGE_MODEL:-deepseek-v4-pro}"     # large e-infra judge model
JUDGE_BASE_URL="${JUDGE_BASE_URL:-https://llm.ai.e-infra.cz/v1}"
MAX_TOKENS="${MAX_TOKENS:-4000}"                  # headroom for a reasoning judge before the JSON

# Judge keys from the e-infra pool (the pipeline assigns judging to these two).
# Comma-separated; total parallelism = (#keys) * CONCURRENCY_PER_KEY.
JUDGE_KEYS="${JUDGE_KEYS:-EINFRA_VS,EINFRA_KD}"
CONCURRENCY_PER_KEY="${CONCURRENCY_PER_KEY:-4}"
RETRY_ATTEMPTS="${RETRY_ATTEMPTS:-4}"
LONG_RETRY_SLEEP="${LONG_RETRY_SLEEP:-50}"
REQUEST_JITTER_MIN="${REQUEST_JITTER_MIN:-0.1}"
REQUEST_JITTER_MAX="${REQUEST_JITTER_MAX:-0.5}"

# Work matrix -- defaults to both local-GPU models, full set.
MODELS="${MODELS:-gemma4-e4b tiny-aya-global}"
DATASETS="${DATASETS:-cs-qa sk-qa}"
VARIANTS="${VARIANTS:-cf fa}"
LANGUAGES="${LANGUAGES:-en cs sk}"
SAMPLE_SIZE="${SAMPLE_SIZE:-all}"                 # "all" or an integer for a smoke

if [ ! -x "$PYTHON" ]; then
  echo "Missing Python executable: $PYTHON" >&2
  echo "Create the CPU venv first (see METACENTRUM_RUNBOOK.md)." >&2
  exit 1
fi

mkdir -p logs "$JUDGE_OUTPUT_DIR"
START_TS=$(date +%s)
echo "[start] $(date '+%Y-%m-%d %H:%M:%S') host=$(hostname) judge=$JUDGE_MODEL keys=$JUDGE_KEYS conc/key=$CONCURRENCY_PER_KEY max_tokens=$MAX_TOKENS"
echo "[matrix] models='$MODELS' datasets='$DATASETS' variants='$VARIANTS' languages='$LANGUAGES' sample_size=$SAMPLE_SIZE"

judged_files=0
missing_files=0
for model in $MODELS; do
  for dataset in $DATASETS; do
    for variant in $VARIANTS; do
      for language in $LANGUAGES; do
        csv="$OUTPUT_ROOT/generated/$model/${dataset}_${variant}_${language}.csv"
        if [ ! -f "$csv" ]; then
          echo "[skip-missing] $csv"
          missing_files=$((missing_files + 1))
          continue
        fi
        echo "[judge] $csv"
        # --allow-failures: write any failed rows to <out>.failures.jsonl and exit 0
        # so one bad row/file never aborts the whole sweep. Re-running resumes,
        # because judge_csv.py skips eids already scored for this model+endpoint.
        "$PYTHON" llm-judge/judge_csv.py \
          "$csv" \
          --sample-size "$SAMPLE_SIZE" \
          --model "$JUDGE_MODEL" \
          --judge-base-url "$JUDGE_BASE_URL" \
          --token-env-vars "$JUDGE_KEYS" \
          --concurrency-per-key "$CONCURRENCY_PER_KEY" \
          --max-tokens "$MAX_TOKENS" \
          --retry-attempts "$RETRY_ATTEMPTS" \
          --long-retry-sleep "$LONG_RETRY_SLEEP" \
          --request-jitter-min "$REQUEST_JITTER_MIN" \
          --request-jitter-max "$REQUEST_JITTER_MAX" \
          --output-dir "$JUDGE_OUTPUT_DIR" \
          --allow-failures \
          || echo "[warn] judge_csv.py returned non-zero for $csv; continuing"
        judged_files=$((judged_files + 1))
      done
    done
  done
done

END_TS=$(date +%s); ELAPSED=$((END_TS - START_TS))
printf '[done] end=%s elapsed=%02d:%02d:%02d judged_files=%d missing_files=%d outputs under %s\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')" \
  $((ELAPSED/3600)) $(((ELAPSED%3600)/60)) $((ELAPSED%60)) \
  "$judged_files" "$missing_files" "$JUDGE_OUTPUT_DIR"
